---
import activity from '../data/activity.json';
import { buildGrid } from '../lib/heatmap.mjs';

interface Props { lang?: 'en' | 'tr' }
const { lang = 'en' } = Astro.props;
const locale = lang === 'tr' ? 'tr-TR' : 'en-GB';
const { weeks, months, total } = buildGrid(activity.days, activity.generatedAt, locale);
const fmt = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const t = lang === 'tr'
  ? {
      day: (n: number, d: string) => `${fmt(d)}: ${n === 0 ? 'katkı yok' : `${n} katkı`}`,
      total: (n: number) => `Son 6 ayda ${n.toLocaleString('tr-TR')} katkı`,
      less: 'Az', more: 'Çok',
    }
  : {
      day: (n: number, d: string) => `${n === 0 ? 'No' : n} contribution${n === 1 ? '' : 's'} on ${fmt(d)}`,
      total: (n: number) => `${n === 0 ? 'No' : n.toLocaleString('en-US')} contribution${n === 1 ? '' : 's'} in the last 6 months`,
      less: 'Less', more: 'More',
    };
---
<div class="scroll" dir="rtl">
  <div class="heat" dir="ltr" role="img" aria-label={t.total(total)} style={`--weeks: ${weeks.length}`}>
    <div class="months">
      {months.map((m) => <span style={`grid-column: ${m.col + 1}`}>{m.label}</span>)}
    </div>
    <div class="cells">
      {weeks.flat().map((d) => <i class={`l${d.level}`} title={t.day(d.count, d.date)}></i>)}
    </div>
    <div class="foot">
      <span>{t.total(total)}</span>
      <span class="legend">{t.less} <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> {t.more}</span>
    </div>
  </div>
</div>

<style>
  .scroll { overflow-x: auto; margin-top: 12px; text-align: left; }
  .heat { --cell: 10px; display: inline-grid; gap: 4px; }
  .months, .cells { display: grid; grid-template-columns: repeat(var(--weeks), var(--cell)); column-gap: 2px; }
  .months { height: 16px; font-size: 11px; line-height: 16px; color: var(--muted); }
  .months span { white-space: nowrap; }
  .cells { grid-template-rows: repeat(7, var(--cell)); grid-auto-flow: column; row-gap: 2px; }
  i { display: block; width: var(--cell); height: var(--cell); border-radius: 2px; }
  .legend i { --cell: 8px; }
  .l0 { background: var(--heat-0); } .l1 { background: var(--heat-1); } .l2 { background: var(--heat-2); }
  .l3 { background: var(--heat-3); } .l4 { background: var(--heat-4); }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 4px; font-size: 12px; color: var(--muted); white-space: nowrap; }
  .legend { display: flex; align-items: center; gap: 3px; }
</style>
