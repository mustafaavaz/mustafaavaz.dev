---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../site.mjs';

interface Props { title?: string; description?: string }
const { title = site.name, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/me.jpg', site.url)} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <main class="col"><slot /></main>
    <footer class="col site-foot">
      <span><span class="live" aria-hidden="true">●</span> <span data-clock></span> in Istanbul</span>
      <span>mustafaavaz.dev</span>
    </footer>
    <script is:inline define:vars={{ email: site.email }}>
      async function copyEmail() {
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          location.href = `mailto:${email}`;
          return;
        }
        document.querySelectorAll('.copy-hint').forEach((el) => {
          el.classList.add('done');
          setTimeout(() => el.classList.remove('done'), 1500);
        });
      }
      document.querySelectorAll('[data-copy-email]').forEach((b) => b.addEventListener('click', copyEmail));
      addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'c' || e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
        if (e.target.closest?.('input, textarea, select, [contenteditable]')) return;
        copyEmail();
      });

      const clock = document.querySelector('[data-clock]');
      const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Istanbul', hour: 'numeric', minute: '2-digit' });
      const tick = () => { clock.textContent = fmt.format(new Date()).toLowerCase(); };
      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
