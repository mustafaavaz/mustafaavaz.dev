---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, readingTime, type Post } from '../../lib/posts';
import { site } from '../../site.mjs';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} — ${site.name}`} description={post.data.description}>
  <a class="back" href="/" data-home>← {site.name}</a>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">{date} · {readingTime(post.body)} min read</p>
    <div class="prose"><Content /></div>
  </article>
  <nav class="end">
    <a href="/" data-home>← Back home</a>
    <span class="copy-hint">
      <span class="copy-key">Press <button class="kbd" type="button" data-copy-email aria-label="Copy email address">C</button> to copy my email</span>
      <button class="copy-touch chip" type="button" data-copy-email>Tap to copy my email</button>
    </span>
  </nav>
  <script is:inline>
    // Send "home" back to the Turkish page when the reader came from it.
    if (document.referrer.startsWith(location.origin + '/tr/')) {
      document.querySelectorAll('[data-home]').forEach((a) => a.setAttribute('href', '/tr/'));
    }
  </script>
</Base>

<style>
  .back { color: var(--muted); text-decoration: none; font-size: 14px; }
  h1 { font-size: 22px; letter-spacing: -0.01em; line-height: 1.3; margin-top: 28px; }
  .meta { color: var(--faint); font-size: 14px; margin: 6px 0 28px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(h2) { font-size: 16px; margin: 30px 0 8px; }
  .prose :global(h3) { font-size: 15px; margin: 24px 0 6px; }
  .prose :global(a) { color: var(--blue); text-decoration-color: #b8c5ec; }
  .prose :global(ul), .prose :global(ol) { padding-left: 20px; margin: 0 0 16px; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .prose :global(blockquote) { margin: 0 0 16px; padding-left: 14px; border-left: 2px solid var(--line); color: var(--muted); }
  .prose :global(code) { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 13px; }
  .prose :global(:not(pre) > code) { background: var(--code); padding: 1px 5px; border-radius: 4px; }
  .prose :global(pre) {
    background: var(--code) !important; border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 16px; margin: 0 0 16px; overflow-x: auto; line-height: 1.6;
  }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 16px; font-size: 14px; }
  .prose :global(th), .prose :global(td) { padding: 6px 14px 6px 0; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  .prose :global(th) { font-weight: 600; color: var(--muted); }
  .prose :global(figure) { margin: 24px 0; }
  .prose :global(figure svg) { display: block; width: 100%; max-width: 440px; height: auto; margin: 0 auto; }
  .prose :global(figcaption) { margin-top: 8px; font-size: 13px; color: var(--muted); text-align: center; }
  /* Inline SVG diagrams in posts draw with the site's tokens. */
  .prose :global(.bx) { fill: var(--chip); stroke: var(--line); }
  .prose :global(.bx-hi) { fill: #e6ebf8; stroke: var(--blue); }
  .prose :global(.ar) { stroke: var(--faint); fill: none; stroke-width: 1.5; }
  .prose :global(.t) { fill: var(--ink); font-size: 13px; font-weight: 500; }
  .prose :global(.ts) { fill: var(--muted); font-size: 11.5px; }
  .prose :global(.b0) { fill: #d8d2c5; }
  .prose :global(.b1) { fill: var(--blue); }
  .end {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    margin-top: 32px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px;
  }
</style>
